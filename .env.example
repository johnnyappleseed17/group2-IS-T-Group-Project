# Copy this file to .env and fill in the sending mailbox.
# .env is ignored by git. Do not commit the real password.
#
# EMAIL_HOST_USER is only the mailbox Django signs in with to send mail.
# Messages are delivered to the email address each person entered at sign-up
# or on the password reset form, not to this mailbox.
#
# University of Nebraska Omaha mail uses Microsoft 365.
# Gmail uses smtp.gmail.com, port 587, and a Google app password.

EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SITE_URL=http://127.0.0.1:8000
